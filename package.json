{
  "name": "r-toolkit",
  "displayName": "R Toolkit",
  "description": "R language tooling for VS Code: R6 OOP support (go-to-definition, completion, hover, outline), with more R features to come.",
  "version": "0.1.0",
  "publisher": "zyhpoes",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "R",
    "R6",
    "R6Class",
    "OOP",
    "language",
    "intellisense"
  ],
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "configuration": {
      "title": "R Toolkit",
      "properties": {
        "r-toolkit.boxPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "box 模块根目录（等价于 R 里的 `options(box.path = ...)`，可写多个，按书写顺序依次查找）。留空则自动推断：先读项目级 `.Rprofile` 的 `box.path`，再退回 VS Code 工作区根。每个条目支持三种写法：绝对路径（`D:/proj/R`）、相对工作区根的相对路径（`R`）、以及 `${workspaceFolder}` 占位符（如 `${workspaceFolder}/R`）。"
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.134.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.ts": ["eslint --fix", "node scripts/typecheck.mjs"],
    "*.{json,md,mjs}": ["eslint --fix"]
  }
}
